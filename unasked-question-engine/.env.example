# Copy this file to `.env` (inside backend/ or the project root) and fill in values.
# NEVER commit the real .env file. Keys are only ever read by the backend.

# ---------------------------------------------------------------- General
APP_ENV=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---------------------------------------------------------------- Upload limits
MAX_UPLOAD_MB=10
MAX_FILES=10
MAX_DESCRIPTION_CHARS=20000
MAX_CSV_ROWS=20000
MAX_PDF_PAGES=300

# ---------------------------------------------------------------- LLM call behaviour
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2
LLM_BACKOFF_BASE_SECONDS=1.0
LLM_MAX_RETRY_DELAY_SECONDS=30
LLM_MAX_SCHEMA_REPAIRS=1

# ---------------------------------------------------------------- Provider API keys
# Supported providers: gemini, groq, deepseek. Leave a key blank if you do not use that provider.
# You can also paste keys in the app (Settings), which writes this file for you.
GEMINI_API_KEY=
GROQ_API_KEY=
DEEPSEEK_API_KEY=

# Optional endpoint overrides
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GROQ_BASE_URL=https://api.groq.com/openai/v1
DEEPSEEK_BASE_URL=https://api.deepseek.com
# Max characters of project material per request (0 = built-in default). Lower these if a provider
# rejects large requests (free tiers often do).
GEMINI_CONTEXT_CHARS=0
GROQ_CONTEXT_CHARS=0
DEEPSEEK_CONTEXT_CHARS=0

# ---------------------------------------------------------------- Role routing
# Model A: initial analysis and finding extraction
# Model B: independent critique, missing-question discovery, counterarguments
# Model C: evidence validation, deduplication, prioritization, final synthesis
#
# Set the provider (gemini | groq | deepseek) and the exact model ID that your
# account can use. Model IDs are intentionally left blank: they change over time. The Settings page
# can list the IDs your key can use. Suggested split: A = gemini, B = groq, C = deepseek.
# The optional fallback is used only if the primary provider fails.
LLM_A_PROVIDER=
LLM_A_MODEL=
LLM_A_FALLBACK_PROVIDER=
LLM_A_FALLBACK_MODEL=

LLM_B_PROVIDER=
LLM_B_MODEL=
LLM_B_FALLBACK_PROVIDER=
LLM_B_FALLBACK_MODEL=

LLM_C_PROVIDER=
LLM_C_MODEL=
LLM_C_FALLBACK_PROVIDER=
LLM_C_FALLBACK_MODEL=
